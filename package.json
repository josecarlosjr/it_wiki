{
  "name": "it-wiki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:web": "next build",
    "search:index": "pagefind --site out --glob \"**/*.{html}\"",
    "build": "npm run build:web && npm run search:index"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "pagefind": "^1.3.0",
    "typescript": "^5.7.0",
    "@eslint/eslintrc": "^3.2.0"
  }
}
